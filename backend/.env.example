# Copy to .env and fill in real values. Never commit the .env itself.

NODE_ENV=development
PORT=5055

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/self-excellence

# Use different, randomly generated values of at least 32 characters in production.
JWT_SECRET=replace-with-at-least-32-random-characters
OTP_SECRET=replace-with-a-different-32-character-secret
JWT_EXPIRES_IN=7d

# Comma-separated explicit origins. Production origins must use HTTPS.
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173

# Feature flag for Sacred Books module (Buy + Distribute)
BOOKS_ENABLED=true

# Google OAuth 2.0 credentials. The secret is server-only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SITE_URL=http://127.0.0.1:5173
