{
  "name": "self-excellence-platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:local": "node scripts/dev.mjs",
    "dev:external": "node scripts/dev.mjs --external",
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "check:architecture": "node scripts/check-architecture.mjs",
    "test": "npm run test --workspace backend",
    "build": "npm run build --workspace frontend",
    "audit": "npm audit --workspaces --include-workspace-root --audit-level=high",
    "verify": "npm run check:architecture && npm run test && npm run build && npm run audit"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
